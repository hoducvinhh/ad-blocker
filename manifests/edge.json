{
  "manifest_version": 3,
  "name": "Universal Ad Blocker",
  "description": "Block common advertising and tracking requests across Chromium browsers.",
  "version": "0.1.0",
  "permissions": [
    "storage",
    "tabs",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Universal Ad Blocker",
    "default_popup": "src/popup/popup.html"
  },
  "options_page": "src/options/options.html",
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/content/youtube-player-cleaner.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/shared/domain-utils.js",
        "src/core/cosmetic-filter.js",
        "src/content/dom-scanner.js",
        "src/content/popup-protection.js",
        "src/content/youtube-ad-blocker.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "filters/cosmetic-rules.json",
        "filters/custom-rules.json",
        "src/content/youtube-player-cleaner.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
